# ==============================================================================
# CINEMATIC - Full-Stack Movie Ticket Booking Platform Environment Variables
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL with Prisma)
DATABASE_URL=postgresql://cinematic_user:cinematic_secure_pass@localhost:5432/cinematic_db?schema=public

# Authentication & Session Security
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long_production
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_chars_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Payment Gateway (Razorpay India - Test Mode)
# Sign up at https://dashboard.razorpay.com to obtain test credentials
RAZORPAY_KEY_ID=rzp_test_CinematicDemoKeyId
RAZORPAY_KEY_SECRET=rzp_test_CinematicDemoSecretKey
RAZORPAY_WEBHOOK_SECRET=rzp_test_CinematicWebhookSecret

# Movie Metadata (The Movie Database - TMDB)
# Obtain an API key from https://www.themoviedb.org/settings/api
# If left blank, Cinematic operates seamlessly using curated rich movie seed data
TMDB_API_KEY=

# Optional: Transactional Email Delivery (Resend / SendGrid / Nodemailer)
# If left blank, emails are logged safely to the server console in development
EMAIL_PROVIDER=console
EMAIL_FROM=bookings@cinematic.example.com
RESEND_API_KEY=

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
